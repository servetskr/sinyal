{
  "manifest_version": 3,
  "name": "mdSinyal MEBBİS Yardımcısı",
  "version": "1.8.0",
  "description": "mdSinyal kayıtlarını kursun kendi MEBBİS oturumunda forma yazar, MEBBİS listelerini aktarır. Şifre istemez, saklamaz.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mebbis.meb.gov.tr/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mebbis.meb.gov.tr/*"
      ],
      "js": [
        "mebbis.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://servetskr.github.io/sinyal/*",
        "https://mdsinyal.com/*",
        "https://www.mdsinyal.com/*"
      ],
      "js": [
        "sinyal.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "simge.png"
  }
}
