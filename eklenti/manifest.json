{
  "manifest_version": 3,
  "name": "Sinyal MEBBİS Yardımcısı",
  "version": "1.0.1",
  "description": "Sinyal'deki kayıt, ders programı ve sınav bilgilerini kursun kendi MEBBİS oturumunda forma yazar. Şifre istemez, saklamaz.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mebbis.meb.gov.tr/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mebbis.meb.gov.tr/*"
      ],
      "js": [
        "mebbis.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://servetskr.github.io/sinyal/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "sinyal.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "simge-16.png",
    "48": "simge-48.png",
    "128": "simge.png"
  },
  "action": {
    "default_title": "Sinyal MEBBİS Yardımcısı",
    "default_icon": {
      "16": "simge-16.png",
      "48": "simge-48.png"
    }
  },
  "homepage_url": "https://servetskr.github.io/sinyal/"
}