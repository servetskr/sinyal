{
  "manifest_version": 3,
  "name": "ÖzSinyal MEBBİS Yardımcısı",
  "version": "1.7.0",
  "description": "ÖzSinyal'deki kayıt, direksiyon programı ve sınav bilgilerini kursun kendi MEBBİS oturumunda forma yazar; MEBBİS listelerini ÖzSinyal'e aktarır. Şifre istemez, saklamaz.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mebbis.meb.gov.tr/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mebbis.meb.gov.tr/*"
      ],
      "js": [
        "mebbis.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://servetskr.github.io/sinyal/*",
        "https://ozsinyal.com/*",
        "https://www.ozsinyal.com/*"
      ],
      "js": [
        "sinyal.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "simge.png"
  }
}
