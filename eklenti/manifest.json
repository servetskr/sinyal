{
  "manifest_version": 3,
  "name": "mdSinyal MEBBİS Yardımcısı",
  "version": "1.18.0",
  "description": "mdSinyal ile MEBBİS arasında toplu veri çekme ve aktarma. Kursun kendi MEBBİS oturumunda çalışır; şifre istemez, saklamaz.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mebbis.meb.gov.tr/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mebbis.meb.gov.tr/*"
      ],
      "js": [
        "tasi.js",
        "motor.js",
        "mebbis.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://servetskr.github.io/sinyal/*",
        "https://mdsinyal.com/*",
        "https://www.mdsinyal.com/*"
      ],
      "js": [
        "sinyal.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "simge-16.png",
    "48": "simge-48.png",
    "128": "simge.png"
  },
  "action": {
    "default_title": "mdSinyal MEBBİS Yardımcısı",
    "default_icon": {
      "16": "simge-16.png",
      "48": "simge-48.png"
    },
    "default_popup": "popup.html"
  },
  "homepage_url": "https://mdsinyal.com/"
}
