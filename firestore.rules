rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function girdi() { return request.auth != null; }
    function uyeYol(k) { return /databases/$(db)/documents/kurslar/$(k)/uyeler/$(request.auth.uid); }
    function uye(k) { return girdi() && exists(uyeYol(k)); }
    function mudur(k) { return girdi() && get(uyeYol(k)).data.rol == 'mudur'; }
    function davet(k, kod) { return get(/databases/$(db)/documents/kurslar/$(k)/davetler/$(kod)).data; }
    function roller() { return ['mudur', 'sekreter', 'usta']; }

    // kullanıcı → hangi kursa bağlı (yalnız kendisi)
    match /kullanicilar/{uid} {
      allow read, write: if girdi() && request.auth.uid == uid;
    }

    match /kurslar/{k} {
      allow read: if uye(k);
      allow create: if girdi() && request.resource.data.sahip == request.auth.uid;
      allow update: if mudur(k) && request.resource.data.sahip == resource.data.sahip;

      match /uyeler/{uid} {
        allow read: if uye(k);
        // kurucu müdür (kurs ile aynı anda) ya da geçerli davetle katılan kişi
        allow create: if girdi() && request.auth.uid == uid && request.resource.data.rol in roller() && (
          (getAfter(/databases/$(db)/documents/kurslar/$(k)).data.sahip == request.auth.uid && request.resource.data.rol == 'mudur')
          || (request.resource.data.davet is string
              && davet(k, request.resource.data.davet).rol == request.resource.data.rol
              && davet(k, request.resource.data.davet).usta == request.resource.data.usta
              && davet(k, request.resource.data.davet).son > request.time));
        allow update: if mudur(k) && request.auth.uid != uid && request.resource.data.rol in roller();
        allow delete: if mudur(k) && request.auth.uid != uid;
      }

      match /davetler/{kod} {
        allow get: if true;
        allow list, create: if mudur(k);
        allow delete: if mudur(k) || (girdi() && getAfter(uyeYol(k)).data.davet == kod);
      }

      // zamanlı mesajı ilk sahiplenen cihaz gönderir: belge bir kez oluşur, değişmez
      match /gonderim/{id} {
        allow get: if uye(k);
        allow create: if uye(k) && request.resource.data.uid == request.auth.uid;
      }
      // makbuz sayacı
      match /sayac/{id} {
        allow read, write: if uye(k);
      }
      // işlem kaydı: yalnız eklenir; kimse değiştiremez, silemez; müdür okur
      match /kayit/{id} {
        allow read: if mudur(k);
        allow create: if uye(k) && request.resource.data.uid == request.auth.uid && request.resource.data.zaman == request.time;
      }
      // günlük yedek: değiştirilemez; 30 günden eski olanı yalnız müdür siler
      match /yedekler/{id} {
        allow read: if mudur(k);
        allow create: if uye(k) && get(uyeYol(k)).data.rol in ['mudur', 'sekreter'];
        allow delete: if mudur(k) && request.time > resource.data.olusturma + duration.value(30, 'd');
      }
      // öğrenci paneli: kişisel linkin belgesi (kod tahmin edilemez, listelenemez)
      match /ogrenciler/{kod} {
        allow get: if true;
        allow create, update, delete: if uye(k);
      }
      // öğrenciden gelenler: yalnız geçerli linkle eklenir; kurs cihazı okur, işleyince siler
      match /ogrenciGelen/{id} {
        allow create: if request.resource.data.kod is string
          && get(/databases/$(db)/documents/kurslar/$(k)/ogrenciler/$(request.resource.data.kod)).data.kursiyer == request.resource.data.kursiyer
          && request.resource.data.zaman == request.time;
        allow read, delete: if uye(k);
      }
      match /v/{parca} {
        allow read, write: if uye(k);
      }
      match /dosyalar/{id} {
        allow read: if uye(k);
        allow create, update: if uye(k) && request.resource.data.v is string && request.resource.data.v.size() < 1000000;
      }
    }
  }
}
